{
  "name": "bearroom-current-runtime",
  "private": true,
  "version": "19.0.0",
  "type": "module",
  "scripts": {
    "restore:assets": "node scripts/restore-assets.mjs",
    "restore:sources": "node scripts/restore-assets.mjs --sources",
    "pretest": "npm run restore:assets",
    "prebuild": "npm run restore:assets",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && npm run build && node scripts/verify-dist.mjs && npm run budget",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "budget": "node scripts/resource-budget.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "rollup": "4.64.2"
  }
}
